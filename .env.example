# Development examples only. Replace the password in your local .env.
POSTGRES_USER=aletheia
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=aletheia
POSTGRES_HOST_PORT=5433
BACKEND_PORT=8000

# Optional override. Compose normally builds the URL from the settings above.
# Inside Compose use db:5432; from the host use localhost:5433.
DATABASE_URL=

# Redis holds temporary state only. Host tools use localhost:6380.
REDIS_URL=redis://redis:6379/0
REDIS_HOST_PORT=6380

# Fixed session lifetime: 8 hours. Secure defaults to true in Python.
SESSION_TTL_SECONDS=28800
SESSION_PUBLIC_ORIGIN=http://localhost:8000
# false is permitted only for local HTTP development; use true with HTTPS.
SESSION_COOKIE_SECURE=false
AUTHORIZATION_CODE_TTL_SECONDS=120

# Google OAuth web client. Leave credentials empty to disable login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Campus affiliation rules are editable in auth/affiliation.py.
# Optional Workspace restriction, validated against the signed hd claim.
GOOGLE_HOSTED_DOMAIN=
