Enum user_affiliation {
  student
  teacher
  alumni
}

Table users {
  id uuid [
    pk,
    not null,
    default: `gen_random_uuid()`,
    note: 'Aletheia 內部使用者唯一識別碼'
  ]

  email varchar(320) [
    not null,
    unique,
    note: 'Aletheia 業務唯一的電子郵件地址；不作為外部登入身份識別依據'
  ]

  username varchar(255) [
    note: '使用者顯示名稱，可選'
  ]

  is_admin boolean [not null, default: false, note: '基本管理權限，與 affiliation 分離']

  avatar_url text [
    note: '使用者頭像網址，可選'
  ]

  affiliation user_affiliation [
    not null,
    note: '校園身分類型，例如 student、teacher、alumni'
  ]

  disabled_at timestamptz [
    note: '由 Aletheia 手動停用帳號的時間；null 表示未停用'
  ]

  disabled_reason text [
    note: '帳號被手動停用的原因'
  ]

  created_at timestamptz [
    not null,
    default: `now()`,
    note: '首次完成 Aletheia 註冊的時間'
  ]

  updated_at timestamptz [
    not null,
    default: `now()`,
    note: '帳號資料最後更新時間；SQLAlchemy 更新時刷新，非 DB trigger'
  ]

  indexes {
    affiliation [name: 'ix_users_affiliation']
    disabled_at [name: 'ix_users_disabled_at']
  }
}

Table external_identities {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  provider varchar(255) [not null, note: '身份來源，例如 google；OIDC Provider 必須使用可區分 issuer 的穩定識別值']
  subject varchar(255) [not null, note: 'Provider 內的穩定身份識別碼，例如 Google sub']

  indexes {
    (provider, subject) [unique, name: 'uq_external_identities_provider_subject']
    user_id [name: 'ix_external_identities_user_id']
  }
}

Ref: external_identities.user_id > users.id [delete: cascade]

Table oauth_attempts {
  state_hash varchar(64) [pk, not null, note: '一次性 OAuth state 的 SHA-256']
  browser_hash varchar(64) [not null, note: '暫時瀏覽器握手 cookie 的 SHA-256']
  nonce varchar(64) [not null]
  continuation_hash varchar(64) [note: '綁定瀏覽器的 SSO 授權續接，Google 登入與原請求不可互換']
  code_verifier varchar(128) [not null, note: '短期 PKCE verifier，不是登入 session']
  expires_at timestamptz [not null]

  indexes {
    expires_at [name: 'ix_oauth_attempts_expires_at']
  }
}

Enum sso_client_type {
  public
  confidential
}

Enum sso_trust_level {
  first_party
  external
}

Table sso_clients {
  client_id varchar(64) [pk, not null]
  name varchar(255) [not null]
  client_type sso_client_type [not null]
  trust_level sso_trust_level [not null]
  enabled boolean [not null, default: true]
  redirect_uris jsonb [not null, note: '精確匹配的 URI 陣列']
  allowed_scopes jsonb [not null, note: '允許的 Scope 陣列']
  secret_hash text [note: 'public 為 null；confidential 僅儲存 scrypt hash']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Enum eligibility_status {
  eligible
  ineligible
  unknown
}

Enum eligibility_verification_status {
  test
  unverified
  verified
}

Table student_eligibility {
  user_id uuid [pk, not null]
  status eligibility_status [not null]
  source varchar(128) [not null]
  verification_status eligibility_verification_status [not null]
  updated_at timestamptz [not null]
  valid_until timestamptz
}

Ref: student_eligibility.user_id > users.id [delete: cascade]
